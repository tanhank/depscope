# 多阶段构建 DepScope HTTP API 服务镜像
FROM golang:1.26.11-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /depscope-api ./cmd/depscope-api

FROM alpine:3.20 AS runner
WORKDIR /app
RUN apk --no-cache add ca-certificates
COPY --from=builder /depscope-api /usr/local/bin/depscope-api
ENV DEPSCOPE_API_ADDR=0.0.0.0:8080
EXPOSE 8080
CMD ["depscope-api"]
